# PostgreSQL connection URL. Do not commit the real .env file.
DATABASE_URL=postgresql+psycopg://lifelog:CHANGE_ME@localhost/lifelog
# Temporary owner used until OAuth/JWT is introduced in phase 2.
DEFAULT_USER_TELEGRAM_ID=example

# Phase 2: leave disabled until Telegram OIDC credentials are configured.
AUTH_ENABLED=false
OAUTH_ISSUER_URL=https://mcp.example.com
MCP_RESOURCE_URL=https://mcp.example.com/mcp
TELEGRAM_CLIENT_ID=CHANGE_ME
TELEGRAM_CLIENT_SECRET=CHANGE_ME
TELEGRAM_REDIRECT_URI=https://mcp.example.com/auth/telegram/callback
JWT_SIGNING_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Telegram Bot API notifications. These are distinct from Telegram OIDC credentials.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=lifelog_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
TELEGRAM_WEBHOOK_URL=https://mcp.example.com/telegram/webhook

# Telegram User API / MTProto. These are distinct from OIDC and Bot API settings.
# Generate with: .venv/bin/python -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_USER_WORKER_ENABLED=false
TELEGRAM_USER_POLL_INTERVAL_SECONDS=10
TELEGRAM_USER_AUTH_FLOW_TTL_SECONDS=600
TELEGRAM_QR_WAIT_TIMEOUT_SECONDS=30
TELEGRAM_SEND_CONFIRMATION_TTL_SECONDS=300
TELEGRAM_MAX_MONITORED_DIALOGUES_PER_USER=10
TELEGRAM_MAX_MESSAGES_PER_REQUEST=100

# Standalone encrypted PostgreSQL backup job (not part of notification_outbox).
BACKUP_ENABLED=true
BACKUP_TIME=09:00
BACKUP_TIMEZONE=Europe/Berlin
# Generate with: python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEY=CHANGE_ME
# Optional single-server state/lock locations and upload limits.
BACKUP_STATE_FILE=.backup-state.json
BACKUP_LOCK_FILE=.backup.lock
BACKUP_HTTP_TIMEOUT_SECONDS=120
BACKUP_MAX_FILE_SIZE_BYTES=52428800
