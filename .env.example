# PostgreSQL connection URL. Do not commit the real .env file.
DATABASE_URL=postgresql+psycopg://lifelog:CHANGE_ME@localhost/lifelog
# Temporary owner used until OAuth/JWT is introduced in phase 2.
DEFAULT_USER_TELEGRAM_ID=6944966420

# Phase 2: leave disabled until Telegram OIDC credentials are configured.
AUTH_ENABLED=false
OAUTH_ISSUER_URL=https://mcp.jesarion.com
MCP_RESOURCE_URL=https://mcp.jesarion.com/mcp
TELEGRAM_CLIENT_ID=CHANGE_ME
TELEGRAM_CLIENT_SECRET=CHANGE_ME
TELEGRAM_REDIRECT_URI=https://mcp.jesarion.com/auth/telegram/callback
JWT_SIGNING_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
